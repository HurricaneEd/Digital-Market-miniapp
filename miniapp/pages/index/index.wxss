.home-page {
  min-height: 100vh;
  padding-bottom: 48rpx;
  background: #ffffff;
}

.home-sticky-header {
  position: sticky;
  top: 0;
  z-index: 10;
  background: #ffffff;
  box-shadow: inset 0 -1rpx 0 #e5e5e5;
}

.custom-nav {
  box-sizing: border-box;
  background: #ffffff;
}

.custom-nav-row {
  display: flex;
  box-sizing: border-box;
  align-items: center;
  padding-left: 32rpx;
}

.custom-nav .van-search {
  flex: 1;
  min-width: 0;
  padding: 0;
}

.section {
  padding: 48rpx 24rpx 0;
  background: #ffffff;
}

.product-section {
  min-height: 420rpx;
}

.section-heading {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.section-title {
  color: #111111;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 48rpx;
}

.state-panel,
.inline-error {
  padding: 52rpx 20rpx;
  color: #707072;
  text-align: center;
}

.state-panel van-button {
  display: block;
  width: 160rpx;
  margin: 24rpx auto 0;
}

.error-text {
  color: #d30005;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8rpx;
}

.product-card {
  min-width: 0;
  background: #ffffff;
}

.product-card:active {
  opacity: 0.72;
  transform: scale(0.99);
}

.product-image {
  display: block;
  width: 100%;
  height: 347rpx;
  background: #f5f5f5;
}

.image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #707072;
  font-size: 24rpx;
}

.product-content {
  padding: 16rpx 0 30rpx;
}

.product-name {
  overflow: hidden;
  height: 84rpx;
  color: #111111;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 42rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.product-meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 12rpx;
}

.product-price {
  color: #d30005;
  font-size: 30rpx;
  font-weight: 500;
}

.product-stock {
  color: #707072;
  font-size: 22rpx;
}

.load-more {
  grid-column: 1 / -1;
  padding: 28rpx 20rpx 44rpx;
  color: #707072;
  font-size: 24rpx;
  text-align: center;
}

.load-more van-button {
  display: block;
  width: 180rpx;
  margin: 20rpx auto 0;
}
