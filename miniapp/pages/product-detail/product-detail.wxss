.detail-page {
  min-height: 100vh;
  padding-bottom: 140rpx;
  background: #ffffff;
}

.state-panel {
  padding: 120rpx 24rpx;
  color: #707072;
  text-align: center;
}

.state-panel van-button {
  display: block;
  width: 160rpx;
  margin: 24rpx auto 0;
}

.error-text {
  color: #d30005;
}

.detail-image {
  display: block;
  width: 100%;
  height: 750rpx;
  background: #f5f5f5;
}

.image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #707072;
  font-size: 28rpx;
}

.detail-main {
  padding: 28rpx 24rpx 48rpx;
}

.detail-name {
  color: #111111;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 50rpx;
}

.detail-price {
  margin-top: 16rpx;
  color: #d30005;
  font-size: 44rpx;
  font-weight: 500;
}

.detail-tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 24rpx;
}

.stock-label {
  margin-left: auto;
  color: #707072;
  font-size: 24rpx;
}

.info-section {
  padding: 48rpx 24rpx;
  border-top: 1rpx solid #e5e5e5;
  background: #ffffff;
}

.section-title {
  margin-bottom: 24rpx;
  color: #111111;
  font-size: 36rpx;
  font-weight: 500;
}

.info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #e5e5e5;
  line-height: 38rpx;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  flex: 0 0 160rpx;
  color: #707072;
}

.info-value {
  flex: 1;
  color: #111111;
  text-align: right;
  word-break: break-all;
}

.param-group {
  margin-bottom: 32rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #e5e5e5;
}

.param-group:last-child {
  margin-bottom: 0;
}

.param-group-name {
  margin-bottom: 10rpx;
  color: #39393b;
  font-size: 28rpx;
  font-weight: 500;
}

.param-group .info-row {
  border-bottom: none;
  padding: 12rpx 0;
}
