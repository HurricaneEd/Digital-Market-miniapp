.orders-page {
  min-height: 100vh;
  padding: 0 24rpx 48rpx;
  background: #ffffff;
}

.state-panel {
  padding: 120rpx 24rpx;
  color: #707072;
  text-align: center;
}

.state-panel van-button {
  display: block;
  width: 160rpx;
  margin: 24rpx auto 0;
}

.error-text {
  color: #d30005;
}

.order-card {
  padding: 32rpx 0 40rpx;
  border-bottom: 1rpx solid #e5e5e5;
  background: #ffffff;
}

.order-card:active {
  opacity: 0.72;
  transform: scale(0.99);
}

.order-header,
.order-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-sn {
  overflow: hidden;
  max-width: 70%;
  color: #707072;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-item {
  display: flex;
  margin-top: 28rpx;
}

.item-image {
  flex: 0 0 140rpx;
  width: 140rpx;
  height: 140rpx;
  background: #f5f5f5;
}

.image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #707072;
  font-size: 20rpx;
}

.item-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.item-name {
  color: #111111;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 40rpx;
}

.item-count,
.order-date {
  margin-top: 14rpx;
  color: #707072;
  font-size: 23rpx;
}

.order-footer {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #e5e5e5;
}

.order-total {
  color: #d30005;
  font-size: 32rpx;
  font-weight: 500;
}
