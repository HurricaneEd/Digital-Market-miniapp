<view class="login-page">
  <view class="login-header">
    <view class="login-title">{{ mode === 'login' ? '欢迎回来' : '创建账号' }}</view>
    <view class="login-subtitle">{{ mode === 'login' ? '登录后管理购物车和订单' : '注册后即可开始使用' }}</view>
  </view>

  <view class="form-card">
    <van-field
      wx:if="{{ mode === 'login' }}"
      value="{{ identifier }}"
      label="账号"
      placeholder="用户名、手机号或邮箱"
      clearable
      data-field="identifier"
      bind:change="setField"
    />
    <block wx:else>
      <van-field
        value="{{ username }}"
        label="用户名"
        placeholder="请输入用户名"
        clearable
        data-field="username"
        bind:change="setField"
      />
      <van-field
        value="{{ phone }}"
        label="手机号"
        type="number"
        placeholder="请输入手机号"
        clearable
        data-field="phone"
        bind:change="setField"
      />
      <van-field
        value="{{ email }}"
        label="邮箱"
        type="text"
        placeholder="请输入邮箱"
        clearable
        data-field="email"
        bind:change="setField"
      />
    </block>
    <van-field
      value="{{ password }}"
      label="密码"
      type="password"
      placeholder="请输入密码"
      clearable
      data-field="password"
      bind:change="setField"
    />
    <van-field
      wx:if="{{ mode === 'register' }}"
      value="{{ confirmPassword }}"
      label="确认密码"
      type="password"
      placeholder="请再次输入密码"
      clearable
      data-field="confirmPassword"
      bind:change="setField"
    />

    <view class="form-error" wx:if="{{ error }}">{{ error }}</view>
    <van-button
      class="submit-button"
      block
      type="primary"
      color="#111111"
      loading="{{ submitting }}"
      bindtap="submit"
    >{{ mode === 'login' ? '登录' : '注册并登录' }}</van-button>
    <view class="switch-mode" bindtap="switchMode">
      {{ mode === 'login' ? '没有账号？去注册' : '已有账号？去登录' }}
    </view>
  </view>

  <view class="auth-note">当前使用项目已有的账号密码 + Token 认证；微信身份登录需要后续接入 code2Session。</view>
</view>
