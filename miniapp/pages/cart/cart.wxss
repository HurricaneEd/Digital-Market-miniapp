.cart-page {
  min-height: 100vh;
  padding-bottom: 132rpx;
  background: #ffffff;
}

.state-panel {
  padding: 100rpx 24rpx;
  color: #707072;
  text-align: center;
}

.state-panel van-button {
  display: block;
  width: 160rpx;
  margin: 20rpx auto 0;
}

.error-text {
  color: #d30005;
}

.cart-count {
  padding: 32rpx 24rpx 16rpx;
  color: #111111;
  font-size: 26rpx;
  font-weight: 500;
}

.cart-list {
  padding: 0 24rpx;
}

.swipe-delete {
  display: flex;
  width: 72px;
  height: 100%;
  align-items: center;
  justify-content: center;
  background: #111111;
  color: #ffffff;
  font-size: 28rpx;
}

.cart-item {
  display: grid;
  grid-template-columns: 44rpx minmax(0, 1fr);
  column-gap: 16rpx;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #e5e5e5;
}

.product-main {
  display: flex;
  min-width: 0;
}

.product-image {
  flex: 0 0 176rpx;
  width: 176rpx;
  height: 176rpx;
  background: #f5f5f5;
}

.image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #707072;
  font-size: 22rpx;
}

.product-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.product-name {
  display: -webkit-box;
  overflow: hidden;
  color: #111111;
  font-size: 28rpx;
  line-height: 40rpx;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.product-price {
  margin-top: 24rpx;
  color: #d30005;
  font-size: 30rpx;
  font-weight: 500;
}

.stock-label {
  margin-top: 12rpx;
  color: #707072;
  font-size: 22rpx;
}

.stock-error {
  color: #d30005;
}

.item-actions {
  grid-column: 2;
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 18rpx;
}

.subtotal {
  flex: 1;
  color: #39393b;
  font-size: 24rpx;
  text-align: right;
}

.stock-warning {
  grid-column: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  background: #f5f5f5;
  color: #d30005;
  font-size: 23rpx;
}

van-submit-bar {
  --submit-bar-z-index: 20;
  --submit-bar-height: 56px;
  --submit-bar-button-height: 48px;
  --submit-bar-button-width: 112px;
  box-shadow: inset 0 1rpx 0 #e5e5e5;
}
